  "COURT_RESPONSIBILITY": "«Вы готовы отвечать за пересмотр?»",
  "COURT_ACCEPT": "Я признаю ошибку и согласен на пересмотр",
  "COURT_ACCEPT_MERCY": "Я хотел смягчить наказание, но приму пересмотр",
  "COURT_REFUSE": "Я отказываюсь пересматривать решение",
  "COURT_CONFIRM": "Исправление: %s\nОснование: %s\nПересмотр: %s",
  "COURT_AGREE": "согласен",
  "COURT_DISAGREE": "отказываюсь",
